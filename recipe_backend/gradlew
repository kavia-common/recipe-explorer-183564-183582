#!/usr/bin/env sh

##############################################################################
##
##  Gradle start up script for UN*X (standard wrapper)
##
##############################################################################

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

APP_BASE_NAME=$(basename "$0")

# Resolve APP_HOME
PRG="$0"
# Need this for relative symlinks.
while [ -h "$PRG" ] ; do
  ls=$(ls -ld "$PRG")
  link=$(expr "$ls" : '.*-> \(.*\)$')
  if expr "$link" : '/.*' >/dev/null; then
    PRG="$link"
  else
    PRG=$(dirname "$PRG")"/$link"
  fi
done
SAVED_PWD=$(pwd)
cd "$(dirname "$PRG")/" >/dev/null
APP_HOME=$(pwd -P)
cd "$SAVED_PWD" >/dev/null

# Locate the wrapper jar(s). Include both standard and shared wrapper jars on the classpath if present.
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
SHARED_WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper-shared.jar"
if [ -f "$SHARED_WRAPPER_JAR" ]; then
  CLASSPATH="$CLASSPATH:$SHARED_WRAPPER_JAR"
fi

# Determine JAVA command
if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/bin/java" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
  else
    echo "ERROR: JAVA_HOME is set but java not found at: $JAVA_HOME/bin/java" >&2
    exit 1
  fi
else
  JAVACMD="java"
  command -v java >/dev/null 2>&1 || {
    echo "ERROR: JAVA_HOME is not set and 'java' was not found on PATH." >&2
    exit 1
  }
fi

# OS specific tweaks (Cygwin/MSYS)
case "$(uname)" in
  CYGWIN*|MINGW*|MSYS* )
    APP_HOME=$(printf '%s' "$APP_HOME" | sed -e 's#\\#/#g')
    CLASSPATH=$(printf '%s' "$CLASSPATH" | sed -e 's#\\#/#g')
    ;;
esac

# Escape application args
save () {
  for i do printf %s\\n "$i" | sed "s/'/'\\\\''/g;1s/^/'/;\$s/\$/' \\\\\\\\/"; done
  echo " "
}
APP_ARGS=$(save "$@")

# Build final command
eval set -- $DEFAULT_JVM_OPTS \
  -Dorg.gradle.appname="$APP_BASE_NAME" \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$APP_ARGS"

exec "$JAVACMD" "$@"
