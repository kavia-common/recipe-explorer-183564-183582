#!/usr/bin/env sh
##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################
# This is a minimal, text-mode Gradle wrapper script compatible with CI/containers.

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

APP_BASE_NAME=`basename "$0"`

# Resolve APP_HOME
PRG="$0"
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' >/dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/$link"
  fi
done
SAVED_PWD="`pwd`"
cd "`dirname \"$PRG\"`/" >/dev/null
APP_HOME="`pwd -P`"
cd "$SAVED_PWD" >/dev/null

# Include both wrapper jars (main + shared) on the classpath. Some environments
# only ship the properties file and expect us to download jars at runtime.
# We place jars in gradle/wrapper and reference both to satisfy dependencies.
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar:$APP_HOME/gradle/wrapper/gradle-wrapper-shared.jar"

# Determine JAVA command
if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/bin/java" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
  else
    echo "ERROR: JAVA_HOME is set but java not found at: $JAVA_HOME/bin/java" >&2
    exit 1
  fi
else
  JAVACMD="java"
  command -v java >/dev/null 2>&1 || {
    echo "ERROR: JAVA_HOME is not set and 'java' was not found on PATH." >&2
    exit 1
  }
fi

# OS specific tweaks
case "`uname`" in
  CYGWIN*|MINGW*|MSYS* )
    APP_HOME=`printf '%s' "$APP_HOME" | sed -e 's#\\#/#g'`
    CLASSPATH=`printf '%s' "$CLASSPATH" | sed -e 's#\\#/#g'`
    ;;
esac

# Quote args safely
save () {
  for i do printf %s\\n "$i" | sed "s/'/'\\\\''/g;1s/^/'/;\$s/\$/' \\\\/"; done
  echo " "
}
APP_ARGS=`save "$@"`

# Build final command
eval set -- $DEFAULT_JVM_OPTS \
  -Dorg.gradle.appname="$APP_BASE_NAME" \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$APP_ARGS"

exec "$JAVACMD" "$@"
